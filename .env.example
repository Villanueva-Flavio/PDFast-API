# Server
CROW_HOST=0.0.0.0
CROW_PORT=8003
# Crow log level: 0 debug, 1 info, 2 warning, 3 error, 4 critical
LOG_LEVEL=1

# Security
# Secret used to HMAC the tokens stored in Redis (use a long random value).
ENCRYPTION_KEY=
# Comma separated Host header values accepted (port ignored). Empty accepts any host.
ALLOWED_HOSTS=localhost
# Browser origin allowed by CORS. Empty keeps Crow's default (*).
CORS_ORIGIN=

# Tokens
REDIS_URL=tcp://redis:6379
TOKEN_TTL_SECONDS=3600
MAX_TOKEN_USES=100

# Storage
MEDIA_ROOT=Media
# First path segment after /Media/ that can be read / written.
READABLE_COLLECTIONS=Product,Website
WRITABLE_COLLECTIONS=Product
MAX_UPLOAD_BYTES=52428800
MAX_PATH_DEPTH=6
